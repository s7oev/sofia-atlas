{
  "plugins": ["@shopify/prettier-plugin-liquid"],
  "overrides": [
    {
      "files": [
        "_includes/**/*.html",
        "_layouts/**/*.html",
        "index.html",
        "buildings/**/*.html",
        "prices/**/*.html"
      ],
      "options": {
        "parser": "liquid-html"
      }
    }
  ]
}
